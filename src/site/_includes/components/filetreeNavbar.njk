<nav class="navbar filetree-navbar" aria-label="Mobile navigation">
  <div class="navbar-inner">
    <button
      type="button"
      class="navigation-toggle align-icon"
      @click="showFilesMobile = true"
      aria-label="Open navigation"
      aria-controls="site-navigation-drawer"
      :aria-expanded="showFilesMobile.toString()"
    >
      <i data-lucide="menu" aria-hidden="true"></i>
    </button>

    {% for imp in dynamics.filetree.beforeTitle %}
      {% include imp %}
    {% endfor %}

    {% if meta.siteLogoPath %}
      <a href="/" class="filetree-navbar-home" aria-label="{{ meta.siteName }} home">
        <img class="site-logo" src="{{ meta.siteLogoPath }}" alt="{{ meta.siteName }}">
      </a>
    {% else %}
      <a href="/" class="filetree-navbar-home">
        <span class="site-title">{{ meta.siteName }}</span>
      </a>
    {% endif %}

    {% for imp in dynamics.filetree.afterTitle %}
      {% include imp %}
    {% endfor %}
  </div>

  {% if settings.dgEnableSearch === true %}
    {% include "components/searchButton.njk" %}
  {% endif %}
</nav>
