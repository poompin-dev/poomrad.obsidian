<div
  x-data="{ isDesktop: window.innerWidth >= 1200 || (window.innerWidth >= 1000 && window.innerWidth > window.innerHeight), showFilesMobile: false }"
  x-init="$watch('showFilesMobile', value => document.documentElement.classList.toggle('nav-drawer-open', value))"
  x-on:resize.window="isDesktop = window.innerWidth >= 1200 || (window.innerWidth >= 1000 && window.innerWidth > window.innerHeight); if (isDesktop) showFilesMobile = false"
  x-on:keydown.escape.window="showFilesMobile = false"
>
  <div x-show.important="!isDesktop" style="display: none;">
    {% include "components/filetreeNavbar.njk" %}
  </div>

  <div
    x-show="showFilesMobile && !isDesktop"
    x-transition.opacity
    @click="showFilesMobile = false"
    style="display: none;"
    class="fullpage-overlay"
    aria-hidden="true"
  ></div>

  <div
    id="site-navigation-drawer"
    class="filetree-wrapper"
    x-show.important="isDesktop || showFilesMobile"
    x-transition:enter="nav-drawer-enter"
    x-transition:enter-start="nav-drawer-enter-start"
    x-transition:enter-end="nav-drawer-enter-end"
    x-transition:leave="nav-drawer-leave"
    x-transition:leave-start="nav-drawer-leave-start"
    x-transition:leave-end="nav-drawer-leave-end"
    style="display: none;"
  >
    <nav class="filetree-sidebar" aria-label="Site navigation">
      <div class="filetree-mobile-actions" x-show="!isDesktop" style="display: none;">
        <button type="button" class="nav-drawer-close align-icon" @click="showFilesMobile = false" aria-label="Close navigation">
          <i data-lucide="x" aria-hidden="true"></i>
        </button>
      </div>

      {% for imp in dynamics.filetree.beforeTitle %}
        {% include imp %}
      {% endfor %}

      {% if meta.siteLogoPath %}
        <a href="/" class="filetree-home-link" aria-label="{{ meta.siteName }} home">
          <img class="site-logo" src="{{ meta.siteLogoPath }}" alt="{{ meta.siteName }}">
        </a>
      {% else %}
        <a href="/" class="filetree-home-link">
          <h1>{{ meta.siteName }}</h1>
        </a>
      {% endif %}

      {% for imp in dynamics.filetree.afterTitle %}
        {% include imp %}
      {% endfor %}

      {% if settings.dgEnableSearch === true %}
        {% include "components/searchButton.njk" %}
      {% endif %}

      <div class="filetree-navigation" @click="if (!isDesktop && $event.target.closest('a')) showFilesMobile = false">
        {% include "components/subjectNavigation.njk" %}
      </div>
    </nav>
  </div>
</div>
